{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    // A declaration-only emit takes under a second, and an incremental build
    // skipped it entirely whenever a stale .tsbuildinfo outlived `rm -rf dist`.
    "incremental": false,
    "outDir": "./dist"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/__tests__/**"]
}
