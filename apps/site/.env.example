# dripmetric.com — the two values to set before going live. Both are read at build time.
# Copy to .env.local for local testing; set them in the hosting provider for deploys.

# An HTTPS endpoint that accepts a form POST with an "email" field (Formspree, Loops,
# Buttondown, Tally, your own API...). Fields sent: email, source, founding_seat.
# Empty: "Join the waitlist" opens a pre-filled email to hello@dripmetric.com.
NEXT_PUBLIC_WAITLIST_ENDPOINT=

# The payment link for founding seats.
# Empty: "Claim a founding seat" (on /pricing) goes to the waitlist form, which records
# the request and says so.
NEXT_PUBLIC_FOUNDING_SEAT_URL=
