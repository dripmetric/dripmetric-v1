# dripmetric.com: the landing page's settings.
# Locally: copy to apps/site/.env.local. On Vercel: Settings → Environment Variables.
# Vercel applies a change only to the NEXT deployment, so redeploy after any change.
# Never commit a real value: .env.local is gitignored.

# --- The waitlist endpoint (src/app/api/waitlist) -----------------------------------
# The intake switch. "open" stores addresses. Anything else, including unset, answers
# "The waitlist isn't open yet" and stores nothing.
WAITLIST_INTAKE=

# The site's database connection, as the insert-only role `dripmetric_site`
# (migration 0013). On Supabase: the TRANSACTION pooler URI (port 6543), with the user
# changed to dripmetric_site.<project-ref> and the password you set for that role.
# Locally (pnpm db:up && pnpm db:migrate):
#   postgres://dripmetric_site:dripmetric_site@localhost:54329/dripmetric
SITE_DATABASE_URL=

# The database's CA certificate, so the connection is encrypted AND verified.
# Supabase: Database Settings → SSL Configuration → Download certificate, then paste
# the whole PEM here (or a file path, locally). Without it, a remote database is
# refused rather than reached in plaintext. Not needed for localhost.
DATABASE_CA_CERT=

# --- The welcome-mail automation (placeholder: OFF) ---------------------------------
# Nothing is sent anywhere unless WAITLIST_AUTOMATION is exactly "on" AND both values
# below are set. Until then every address waits in the database, and
# `pnpm waitlist:forward --send` delivers the backlog once the automation exists.
WAITLIST_AUTOMATION=
# An https:// webhook (Zapier, Make, n8n, Loops, your own). It receives a signed JSON
# POST per new address; the contract is in README.md, "The waitlist".
WAITLIST_AUTOMATION_URL=
# The shared signing secret, at least 32 characters: openssl rand -hex 32
WAITLIST_AUTOMATION_SECRET=

# --- Only for a host without a server (the GitHub Pages export) ---------------------
# Read at build time. Overrides the built-in endpoint with an external one (Formspree,
# Loops...). Leave empty on Vercel. With neither, the form opens a pre-filled email.
NEXT_PUBLIC_WAITLIST_ENDPOINT=
